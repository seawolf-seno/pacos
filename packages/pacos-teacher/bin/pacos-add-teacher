#!/bin/bash
# Create a teacher account named after their school email: seno@pacificachristian.org → seno.
# No sudo for teachers. Omarchy's /etc/skel and first-login setup do the rest.
set -euo pipefail

if (( $# != 1 )); then
  echo "Usage: sudo pacos-add-teacher <name or name@pacificachristian.org>" >&2
  exit 1
fi
if (( EUID != 0 )); then
  echo "Run with sudo." >&2
  exit 1
fi

user=${1,,}
user=${user%@pacificachristian.org}
if [[ ! $user =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]]; then
  echo "Not a valid username: $user" >&2
  exit 1
fi
if id "$user" &>/dev/null; then
  echo "$user already exists."
  exit 0
fi

useradd -m -s /bin/bash -c "$user@pacificachristian.org" "$user"
echo "Set a password for $user:"
passwd "$user"
echo "Created $user. They can log in now."
