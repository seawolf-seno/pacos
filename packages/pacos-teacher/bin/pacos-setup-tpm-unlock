#!/bin/bash
# Unlock the disk with the TPM at boot, so the login screen is the only password prompt.
# Switches the initramfs to systemd (needed for TPM unlock) and enrolls the TPM in LUKS.
# The existing disk passphrase keeps working as a fallback.
set -euo pipefail

if (( EUID != 0 )); then
  echo "Run with sudo." >&2
  exit 1
fi
if [[ ! -e /dev/tpmrm0 ]]; then
  echo "No TPM found." >&2
  exit 1
fi

limine_defaults=/etc/default/limine
cryptdevice=$(grep -oE 'cryptdevice=[^ "]+' "$limine_defaults" | head -1 || true)
if [[ -z $cryptdevice ]] && ! grep -q 'rd.luks.name=' "$limine_defaults"; then
  echo "No cryptdevice= in $limine_defaults; is this an encrypted Omarchy install?" >&2
  exit 1
fi

# Two runs. The first switches to the systemd initramfs; the TPM must be enrolled after
# booting that way, or the measured boot state differs and the TPM refuses to unlock.
if [[ -n $cryptdevice ]]; then
  # cryptdevice=PARTUUID=xxx:root → the LUKS device and its mapper name
  spec=${cryptdevice#cryptdevice=}
  name=${spec##*:}
  device=$(blkid -t "${spec%:*}" -o device | head -1)
  luks_uuid=$(cryptsetup luksUUID "$device")

  cp "$limine_defaults" "$limine_defaults.pacos-backup"
  sed -i "s|$cryptdevice|rd.luks.name=$luks_uuid=$name rd.luks.options=$luks_uuid=tpm2-device=auto|" "$limine_defaults"

  cat >/etc/mkinitcpio.conf.d/zz_pacos_tpm.conf <<'HOOKS'
# pacos: systemd initramfs so sd-encrypt can unlock LUKS with the TPM.
_pacos_hooks=()
for _pacos_hook in "${HOOKS[@]}"; do
  case $_pacos_hook in
    udev) _pacos_hooks+=(systemd) ;;
    keymap) _pacos_hooks+=(sd-vconsole) ;;
    consolefont | resume) ;;
    encrypt) _pacos_hooks+=(sd-encrypt) ;;
    btrfs-overlayfs) _pacos_hooks+=(sd-btrfs-overlayfs) ;;
    *) _pacos_hooks+=("$_pacos_hook") ;;
  esac
done
HOOKS=("${_pacos_hooks[@]}")
unset _pacos_hooks _pacos_hook
HOOKS
  limine-mkinitcpio
  echo "Step 1 of 2 done. Reboot (enter the disk passphrase once more), then run this again."
  exit 0
fi

if ! grep -q 'rd.luks.name=' /proc/cmdline; then
  echo "Reboot first, then run this again." >&2
  exit 1
fi

luks_uuid=$(grep -oE 'rd\.luks\.name=[^= ]+' /proc/cmdline | head -1 | cut -d= -f2)
device=$(blkid -U "$luks_uuid")
echo "Enrolling the TPM for $device (enter the current disk passphrase)."
systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs=7 "$device"
echo "Step 2 of 2 done. Reboot: the disk should unlock without a passphrase."
